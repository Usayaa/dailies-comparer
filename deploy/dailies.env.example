# Copy to /etc/dailies.env (chmod 600, owned by root).
# Generate a secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Only send the login cookie over HTTPS.
SESSION_COOKIE_SECURE=1
TIMEZONE=Europe/Berlin
# Optional, defaults to /opt/dailies/instance/dailies.sqlite
# DATABASE_URL=sqlite:////opt/dailies/instance/dailies.sqlite
